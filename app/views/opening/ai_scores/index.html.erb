<% in_progress = @latest_log&.status.in?(%w[pending processing]) %>
<% if in_progress %>
  <meta http-equiv="refresh" content="5">
<% end %>

<div class="flex min-h-full flex-col">
  <div class="mx-auto w-full grow lg:flex xl:px-2 -ml-4">
    <!-- Left sidebar -->
    <div class="w-80 xl:flex">
      <%= render partial: "opening/profile", locals: { opening: @opening } %>
    </div>

    <div class="flex-1">
      <%= render partial: "opening/nav", locals: { opening: @opening } %>

      <div class="p-6 text-sm">

        <!-- Job Progress Banner (visible only when running) -->
        <% if in_progress %>
          <% total     = @latest_log.total_candidates.to_i %>
          <% scored    = @latest_log.successfully_scored.to_i %>
          <% failed    = @latest_log.failed_count.to_i %>
          <% processed = scored + failed %>
          <% pct       = total > 0 ? (processed * 100.0 / total).round : 0 %>

          <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 dark:bg-blue-950 dark:border-blue-800 p-4">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <div class="h-2.5 w-2.5 rounded-full bg-blue-500 animate-pulse"></div>
                <span class="font-semibold text-blue-800 dark:text-blue-200">Scoring in progress</span>
              </div>
              <span class="text-xs text-blue-600 dark:text-blue-400">Auto-refreshing every 5s</span>
            </div>

            <!-- Progress bar -->
            <div class="w-full bg-blue-200 dark:bg-blue-900 rounded-full h-2.5 mb-3">
              <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: <%= pct %>%"></div>
            </div>

            <!-- Stats row -->
            <div class="grid grid-cols-4 gap-3 text-center">
              <div class="bg-white dark:bg-gray-800 rounded p-2 border border-blue-100">
                <p class="text-lg font-bold text-gray-800 dark:text-white"><%= total > 0 ? total : '...' %></p>
                <p class="text-xs text-gray-500">Total</p>
              </div>
              <div class="bg-white dark:bg-gray-800 rounded p-2 border border-blue-100">
                <p class="text-lg font-bold text-green-600"><%= scored %></p>
                <p class="text-xs text-gray-500">Scored</p>
              </div>
              <div class="bg-white dark:bg-gray-800 rounded p-2 border border-blue-100">
                <p class="text-lg font-bold text-red-500"><%= failed %></p>
                <p class="text-xs text-gray-500">Skipped</p>
              </div>
              <div class="bg-white dark:bg-gray-800 rounded p-2 border border-blue-100">
                <p class="text-lg font-bold text-gray-700 dark:text-gray-200"><%= pct %>%</p>
                <p class="text-xs text-gray-500">Done</p>
              </div>
            </div>

            <% if failed > 0 %>
              <p class="mt-2 text-xs text-yellow-700 dark:text-yellow-400">
                <%= failed %> candidate(s) skipped — PDF file missing from storage, corrupted, or too short to read. Their scores can be added manually.
              </p>
            <% end %>
          </div>

        <!-- Warning banner for failed / cost-capped runs -->
        <% elsif @latest_log&.status == 'cost_capped' || @latest_log&.status == 'failed' %>
          <div class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 dark:bg-yellow-950 dark:border-yellow-800 p-4 flex items-start gap-3">
            <span class="text-yellow-600 text-lg">⚠</span>
            <div class="flex-1">
              <p class="font-semibold text-yellow-800 dark:text-yellow-200">
                <%= @latest_log.status == 'cost_capped' ? 'Cost cap reached' : 'Last run failed' %>
              </p>
              <% if @latest_log.error_details.present? %>
                <p class="text-xs text-yellow-700 dark:text-yellow-400 mt-1"><%= @latest_log.error_details.first(120) %></p>
              <% end %>
              <div class="mt-3">
                <%= button_to "Try Again", opening_ai_scores_path(@opening), method: :post, class: "btn-primary text-xs" %>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Header: Generate button + cost estimate (hidden while running) -->
        <% unless in_progress %>
          <div class="mb-6 flex items-center justify-between">
            <div class="flex flex-col">
              <% unless @latest_log&.status.in?(%w[cost_capped failed]) %>
                <%= button_to "Generate Scores", opening_ai_scores_path(@opening), method: :post, class: "btn-primary" %>
              <% end %>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">AI scores assist screening only — every decision still requires human review.</p>
            </div>
            <div class="flex flex-col text-right">
              <p class="text-sm font-medium dark:text-white">Provider: ChatGPT (gpt-4o-mini)</p>
              <p class="text-xs text-gray-500 dark:text-gray-400">Est. cost: $<%= number_with_precision(@cost_estimate_usd, precision: 4) %></p>
            </div>
          </div>
        <% end %>

        <!-- Results table -->
        <% if @ai_scores.any? %>
          <div class="overflow-x-auto">
            <table class="text-sm text-left text-gray-500 dark:text-gray-400 w-full">
              <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                  <th scope="col" class="px-4 py-3">Score</th>
                  <th scope="col" class="px-4 py-3">Name</th>
                  <th scope="col" class="px-4 py-3">Email</th>
                  <th scope="col" class="px-4 py-3">Current Title</th>
                  <th scope="col" class="px-4 py-3 whitespace-nowrap">Added On</th>
                </tr>
              </thead>
              <tbody>
                <% @ai_scores.each do |ai_score| %>
                  <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">
                    <td class="px-4 py-3">
                      <%= link_to opening_ai_score_path(@opening, ai_score), class: "hover:underline" do %>
                        <span class="inline-block px-3 py-1 rounded-full font-semibold <%= ai_score_badge_classes(ai_score.score) %>">
                          <%= ai_score.score %>
                        </span>
                      <% end %>
                    </td>
                    <td class="px-4 py-3">
                      <%= link_to ai_score.candidate.name, opening_ai_score_path(@opening, ai_score), class: "text-blue-600 dark:text-blue-500 hover:underline" %>
                    </td>
                    <td class="px-4 py-3">
                      <%= link_to ai_score.candidate.email, opening_ai_score_path(@opening, ai_score), class: "text-blue-600 dark:text-blue-500 hover:underline" %>
                    </td>
                    <td class="px-4 py-3"><%= ai_score.candidate.current_title.presence || "-" %></td>
                    <td class="px-4 py-3 whitespace-nowrap"><%= display_date(ai_score.created_at) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% elsif !in_progress %>
          <div class="rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-600 p-8 text-center">
            <p class="text-gray-600 dark:text-gray-400 mb-4">No AI scores yet for this opening.</p>
            <%= button_to "Generate Scores", opening_ai_scores_path(@opening), method: :post, class: "btn-primary" %>
          </div>
        <% end %>

      </div>
    </div>

    <!-- Right sidebar -->
    <div class="shrink-0 border-t border-gray-200 px-4 py-6 sm:px-6 lg:w-80 lg:border-l lg:border-t-0 lg:pr-8 xl:pr-6">
      <div>
        <h5 class="mr-3 font-semibold dark:text-white">AI Scoring</h5>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-4">AI-assisted candidate screening using ChatGPT (gpt-4o-mini).</p>

        <% if @latest_log.present? %>
          <div class="bg-gray-50 dark:bg-gray-800 rounded p-3 text-xs space-y-1">
            <p class="font-semibold text-gray-700 dark:text-gray-300 mb-2">Last Run</p>
            <p class="text-gray-600 dark:text-gray-400">
              Status:
              <span class="font-medium <%= @latest_log.status == 'completed' ? 'text-green-600' : @latest_log.status.in?(%w[pending processing]) ? 'text-blue-600' : 'text-yellow-600' %>">
                <%= @latest_log.status.humanize %>
              </span>
            </p>
            <p class="text-gray-600 dark:text-gray-400">Model: <span class="font-medium"><%= @latest_log.model %></span></p>
            <p class="text-gray-600 dark:text-gray-400">Scored: <span class="font-medium"><%= @latest_log.successfully_scored %> / <%= @latest_log.total_candidates %></span></p>
            <p class="text-gray-600 dark:text-gray-400">Skipped: <span class="font-medium"><%= @latest_log.failed_count %></span></p>
            <% if @latest_log.total_cost.to_f > 0 %>
              <p class="text-gray-600 dark:text-gray-400">Cost: <span class="font-medium">$<%= number_with_precision(@latest_log.total_cost, precision: 5) %></span></p>
            <% end %>
            <% if @latest_log.completed_at.present? %>
              <p class="text-gray-600 dark:text-gray-400">Completed: <span class="font-medium"><%= display_date(@latest_log.completed_at) %></span></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
